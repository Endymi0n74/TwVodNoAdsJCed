{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "eqeqeq": ["error", "always"],
        "curly": ["error", "all"],
        "no-empty": ["error", { "allowEmptyCatch": false }]
    }
}

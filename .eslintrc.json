{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "eqeqeq": "off",
        "curly": "off",
        "no-empty": "off",
        "no-redeclare": "off",
        "no-global-assign": "off",
        "no-undef": "off",
        "no-useless-escape": "off",
        "no-unexpected-multiline": "off"
    }
}
